# Copy to .env.local (or .env) and fill in your own values.
# The app runs with only the three Supabase values below; every external
# service has a free/keyless fallback, and anything running on a fallback
# is visibly labeled as such in the UI (e.g. "estimated", "needs a call").

# --- Required -----------------------------------------------------------
# Supabase project URL and keys (Project Settings -> API).
# Newer Supabase projects issue sb_publishable_... / sb_secret_... keys;
# they map 1:1 onto the anon / service-role roles these vars name.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# --- Optional: accuracy upgrades ---------------------------------------
# OpenRouteService (free tier, no credit card): real walking/driving routes.
# Without it, commute time is a haversine estimate labeled "estimated".
ORS_API_KEY=

# Google Places API (New). Enables richer venue discovery and real photos.
# Requires "Places API (New)" enabled on the Cloud project; the legacy
# Places endpoints are not used. Photo fields additionally require the
# project's billing/SKU to permit them, or photos come back empty.
# Without this key, discovery uses the free OpenStreetMap Overpass API.
GOOGLE_PLACES_API_KEY=

# Firecrawl v2: JS-rendering fallback for venue sites whose private-dining
# content is client-rendered and therefore invisible to the static scraper.
# Without it, those venues honestly degrade to "unverified / needs a call".
FIRECRAWL_API_KEY=

# xAI Grok (grok-4.5): schema-constrained extraction tier for pages that
# have a private-dining page but publish no explicit capacity number.
# Results from this tier are labeled "AI-extracted", never "verified".
XAI_API_KEY=
